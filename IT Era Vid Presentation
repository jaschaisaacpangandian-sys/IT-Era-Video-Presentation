<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Group 9 Video Preview</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#F4F8FC;--surface:#FFFFFF;--ink:#0B2F55;--mut:#4F6785;--blue:#1668B8;--onblue:#FFFFFF;--tint:#E3EFFA;--line:#CADDF0;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0A1A2E;--surface:#0F233D;--ink:#E6F0FB;--mut:#9DB4D0;--blue:#63AEF5;--onblue:#08213D;--tint:#16335A;--line:#27476F;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0A1A2E;--surface:#0F233D;--ink:#E6F0FB;--mut:#9DB4D0;--blue:#63AEF5;--onblue:#08213D;--tint:#16335A;--line:#27476F;color-scheme:dark}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font-family:"Figtree",system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.5}
main{max-width:980px;margin:0 auto;padding:20px 16px 32px}
header h1{font-size:1.5rem;font-weight:800;margin:0 0 2px}
header p{margin:0 0 16px;color:var(--mut)}
.stage{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:22px;min-height:380px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:24px}
.meta{display:flex;flex-direction:column;gap:10px;align-content:start}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{background:var(--tint);color:var(--ink);border-radius:999px;padding:3px 12px;font-size:.85rem;font-weight:600}
.meta h2{font-size:1.6rem;line-height:1.15;margin:6px 0 0;font-weight:800}
.meta .note{color:var(--mut);font-size:.95rem;margin:0;font-style:italic}
.caps{display:flex;flex-direction:column;gap:10px;align-content:start}
.c{margin:0;display:grid;grid-template-columns:130px 1fr;gap:12px;padding:10px 12px;border-left:4px solid var(--line);background:var(--bg);border-radius:6px;animation:in .35s ease-out}
.c b{font-weight:800;color:var(--blue);font-size:.95rem}
.c.ai{background:var(--blue);border-left-color:var(--blue)}
.c.ai b,.c.ai span{color:var(--onblue)}
@keyframes in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.bar{display:flex;gap:10px;align-items:center;margin:16px 0 12px;flex-wrap:wrap}
button{font:inherit;cursor:pointer;border-radius:8px;border:1px solid var(--line);background:var(--surface);color:var(--ink);padding:8px 16px;font-weight:600}
button.go{background:var(--blue);color:var(--onblue);border-color:var(--blue);min-width:110px}
button:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
.count{margin-left:auto;color:var(--mut);font-size:.9rem}
.tl{display:flex;gap:3px}
.seg{position:relative;overflow:hidden;padding:0;height:46px;border-radius:6px;background:var(--tint);border:1px solid var(--line);font-size:.75rem;color:var(--ink);text-align:left}
.seg span{position:relative;z-index:1;display:block;padding:0 7px;line-height:44px;white-space:nowrap;overflow:hidden}
.seg i{position:absolute;inset:0 auto 0 0;width:0;background:var(--blue);opacity:.35}
.seg.done i,.seg.on i{width:100%}
.play .seg.on i{animation:f var(--d) linear}
.seg.on{border-color:var(--blue);border-width:2px}
@keyframes f{from{width:0}to{width:100%}}
.axis{display:flex;justify-content:space-between;color:var(--mut);font-size:.8rem;margin-top:4px}
.foot{color:var(--mut);font-size:.85rem;margin-top:18px}
@media (max-width:720px){.stage{grid-template-columns:1fr;padding:16px}.c{grid-template-columns:1fr;gap:2px}.seg span{display:none}}
@media (prefers-reduced-motion:reduce){.c{animation:none}.play .seg.on i{animation:none;width:100%}}
</style>
</head>
<body>
<main>
<header>
<h1>Group 9: Video Preview</h1>
<p>Current Trends in IT: AI and Robots in Health and Medicine. A roughly 30-minute video shown in fast forward.</p>
</header>
<section class="stage" aria-live="polite">
<div class="meta">
<div class="chips"><span class="chip" id="place"></span><span class="chip" id="time"></span></div>
<h2 id="title"></h2>
<p class="note" id="note"></p>
</div>
<div class="caps" id="caps"></div>
</section>
<div class="bar">
<button id="prev">Previous</button>
<button id="play" class="go">Play preview</button>
<button id="next">Next</button>
<span class="count" id="count"></span>
</div>
<div class="tl" id="tl" role="group" aria-label="Video timeline, widths match real running time"></div>
<div class="axis"><span>0:00</span><span>15:00 end of skit</span><span>30:00</span></div>
<p class="foot">Draft for the group to edit. Dialogue and facts are starting points; confirm the facts with your own sources before filming. Members A to D are placeholders until you add names.</p>
</main>
<script>
var S=[
{s:"Title",d:.5,p:"Title card",t:"0:00 to 0:30",h:"Current Trends in IT: AI and Robots in Health and Medicine",n:"Animated title, then each member introduces himself in one sentence.",l:[["Group 9","Welcome. We are Group 9."],["Member A","Our doctor. Presents Robotics."],["Member B","Our nurse. Presents Telemedicine."],["Member C","Mr. Santos. Presents AI in Healthcare."],["Member D","Ramon and the AI voice. Presents challenges and the nurse’s role."]]},
{s:"Skit 1",d:5,p:"Skills lab, ER",t:"0:30 to 5:30",h:"Scene 1: AI in healthcare",n:"Camera: two-shot at the bed, then a laptop screen insert for the AI alert.",l:[["Ramon","Please help. My father has chest pain."],["Nurse","Mr. Santos, I will check your vitals and enter them now."],["AI voice","Alert: high risk of heart failure. Recommend chest imaging."],["Doctor","Thank you. I will review the scan myself before we decide."],["Ramon","Is the computer making the decision?"],["Doctor","No. It supports us. People make the decision."]]},
{s:"Skit 2",d:5,p:"Skills lab, pre-op room",t:"5:30 to 10:30",h:"Scene 2: Robotics and robotic surgery",n:"Camera: over-the-shoulder on the doctor, with an animated robot clip as an insert.",l:[["Doctor","One option is robotic surgery. It uses smaller cuts and can speed up recovery."],["Ramon","A machine will operate on my father?"],["Doctor","The surgeon controls every movement. The robot adds steadiness and precision."],["Ramon","Is it safe? And is it expensive?"],["Doctor","Like any surgery it has risks, and cost can be higher. We will go through both."],["Nurse","Mr. Santos, I will explain what to expect before and after surgery."]]},
{s:"Skit 3",d:4.5,p:"Dorm room, as home",t:"10:30 to 15:00",h:"Scene 3: Telemedicine and remote monitoring",n:"Camera: close-up on the wearable, then split screen with the doctor on a laptop.",l:[["Nurse","This wearable tracks your blood pressure and heart rate at home."],["Mr. Santos","And if something looks wrong?"],["Nurse","The app shares your readings with your doctor."],["Doctor (video call)","Your readings are steady. Let us keep the plan."],["Ramon","He no longer has to travel for hours for every checkup."]]},
{s:"",d:1,p:"School campus",t:"15:00 to 16:00",h:"Transition",n:"Member B steps out of character, then an animated slide opens the discussion.",l:[["Member B","What you just saw is already happening today."],["Group 9","Let us look at each technology more closely."]]},
{s:"AI",d:3,p:"Animated slides, Member C",t:"16:00 to 19:00",h:"AI in healthcare",n:"Add a “Did you know?” popup on this slide.",l:[["What it is","Software that learns patterns from data to support clinical decisions."],["Used today","Reading medical images, early warning of patient decline, decision support."],["Benefits and challenges","Faster, more consistent checks. Risks: biased data, errors, privacy, and accountability."],["Role of the nurse","Verify alerts, watch the patient, and explain results."]]},
{s:"Robots",d:3,p:"Animated slides, Member A",t:"19:00 to 22:00",h:"Robotics and robotic surgery",n:"Use a short animated clip of a surgeon at a console.",l:[["What it is","Machines that assist with procedures or care, guided by people."],["Used today","Surgeon-controlled surgical systems, rehabilitation robots, pharmacy automation."],["Benefits and challenges","Precision and often smaller incisions. Risks: high cost, training, limited access."],["Role of the nurse","Prepare and teach patients, and support the surgical team."]]},
{s:"Telemed",d:3,p:"Animated slides, Member B",t:"22:00 to 25:00",h:"Telemedicine and remote monitoring",n:"Show a simple map of a remote barangay linked to a hospital.",l:[["What it is","Care delivered at a distance, with devices that send patient data to clinicians."],["Used today","Video consultations, home blood pressure and glucose monitoring, wearables."],["Benefits and challenges","Reaches remote areas and saves travel. Risks: weak internet, digital skills, privacy."],["Role of the nurse","Teach patients to use devices and follow up on their readings."]]},
{s:"Challenges",d:3,p:"Animated slides, Member D",t:"25:00 to 28:00",h:"Challenges and the nurse’s role",n:"Close with a slide that ties all three technologies together.",l:[["Privacy","Health data must be protected, in line with the Data Privacy Act of 2012."],["Cost and access","Many communities still lack devices, internet, or specialists."],["Human touch","Technology cannot replace listening, comfort, and judgment."],["Nurses at the center","Educate, verify, advocate, and keep care human."]]},
{s:"Takeaway",d:2,p:"School campus",t:"28:00 to 30:00",h:"Key takeaway and reflection",n:"Each member says one line, then the group closes together.",l:[["Member A","Robots can add precision, but surgeons lead."],["Member B","Telemedicine brings care closer to home."],["Member C","AI supports decisions. People remain responsible."],["Member D","Technology works best when care stays human."],["Group 9","Technology does not replace care. It extends it."]]}
];
var i=0,playing=false,timers=[],$=function(x){return document.getElementById(x)};
function dur(s){return 1200+s.l.length*2400}
function clear(){timers.forEach(clearTimeout);timers=[]}
function line(l){var p=document.createElement("p");p.className="c"+(l[0]==="AI voice"?" ai":"");var b=document.createElement("b");b.textContent=l[0];var t=document.createElement("span");t.textContent=l[1];p.appendChild(b);p.appendChild(t);$("caps").appendChild(p)}
function show(n){
clear();i=n;var s=S[n];
$("place").textContent=s.p;$("time").textContent=s.t;$("title").textContent=s.h;$("note").textContent=s.n;
$("caps").innerHTML="";
$("count").textContent=(n+1)+" of "+S.length;
document.body.classList.toggle("play",playing);
var tl=$("tl");tl.innerHTML="";
S.forEach(function(x,k){var b=document.createElement("button");b.className="seg"+(k<n?" done":"")+(k===n?" on":"");b.style.flex=x.d+" 1 0";b.title=x.h;b.setAttribute("aria-label",x.h+", "+x.t);
var sp=document.createElement("span");sp.textContent=x.s;var f=document.createElement("i");if(k===n)f.style.setProperty("--d",dur(s)+"ms");b.appendChild(f);b.appendChild(sp);b.onclick=function(){show(k)};tl.appendChild(b)});
$("tl").querySelector(".on i").style.setProperty("--d",dur(s)+"ms");
document.getElementById("tl").style.setProperty("--d",dur(s)+"ms");
document.querySelector(".tl .on").style.setProperty("--d",dur(s)+"ms");
$("play").textContent=playing?"Pause":(n===S.length-1&&!playing&&window._ended?"Replay":"Play preview");
if(playing){s.l.forEach(function(l,k){timers.push(setTimeout(function(){line(l)},300+k*2400))});
timers.push(setTimeout(function(){if(i<S.length-1){show(i+1)}else{playing=false;window._ended=true;show(i)}},dur(s)))}
else{s.l.forEach(line)}
}
$("play").onclick=function(){if(playing){playing=false;show(i)}else{window._ended=false;playing=true;show(window._ended?0:(i===S.length-1?0:i))}};
$("prev").onclick=function(){show(Math.max(0,i-1))};
$("next").onclick=function(){show(Math.min(S.length-1,i+1))};
show(0);
</script>
</body>
</html>
